{
  "name": "palabra-arena",
  "private": true,
  "version": "0.2.3-dev",
  "type": "module",
  "scripts": {
    "dev": "node server/dev-runner.mjs",
    "dev:web": "vite",
    "dev:api": "node server/local-server.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "smoke:local": "node scripts/smoke-local-api.mjs",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "preview:cloudflare": "npm run build && wrangler dev",
    "test:cloudflare": "node --test tests/cloudflare.test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "vite": "6.1.0",
    "typescript": "5.7.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3"
  },
  "devDependencies": {
    "wrangler": "^4.45.0"
  }
}
